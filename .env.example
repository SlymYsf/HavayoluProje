APP_NAME="Devlet Havayolları"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://havayoluproje.test
APP_TIMEZONE=Europe/Istanbul

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=devlet_havayollari
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Bildirimler kuyruk üzerinden gönderiliyor; sync olursa gönderim
# isteği bloklar ve yeniden deneme mekanizması devre dışı kalır.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis saf PHP istemcisidir; phpredis uzantısı Windows'ta kurulu değil
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# Geliştirmede postalar storage/logs/laravel.log dosyasına yazılır
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="rezervasyon@devlethavayollari.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===== PİYASA BAZLI FİYATLANDIRMA =====
#
# Bilet fiyatı, USD/TRY kuru ve jet yakıtı spot fiyatındaki değişime göre
# hareket eder. Veri günde bir kez `market:sync` komutuyla çekilir.
#
# Döviz kuru TCMB'den alınır, anahtar gerektirmez.
# Yakıt fiyatı için ücretsiz EIA anahtarı gerekir:
#   https://www.eia.gov/opendata/register.php
#
# Anahtar tanımlı değilse fiyatlandırma çalışmaya devam eder,
# yalnızca piyasa çarpanı 1,00'da sabit kalır.

EIA_API_KEY=

# TÜFE endeksi (TCMB EVDS). Ücretsiz anahtar:
#   https://evds2.tcmb.gov.tr -> üye ol -> profil -> API anahtarı
EVDS_API_KEY=

# routes.base_price değerlerinin tanımlandığı gün.
# Kur ve yakıt fiyatındaki değişim bu güne göre ölçülür.
# Kurulumdan sonra: php artisan market:sync --reference
PRICING_REFERENCE_DATE=2026-07-01

VITE_APP_NAME="${APP_NAME}"
